# ==============================================================================
# MEDCHAIN PRODUCTION & FREE-TIER ENVIRONMENT CONFIGURATION
# Copy to .env and fill with your environment values. DO NOT COMMIT REAL SECRETS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Local PostgreSQL OR Free Managed Cloud DB: Neon / Supabase)
# ------------------------------------------------------------------------------
# For Cloud PostgreSQL (Neon / Supabase), provide DATABASE_URL:
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/medchain?sslmode=require
DATABASE_URL=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medchain
SPRING_DATASOURCE_USERNAME=medchain
SPRING_DATASOURCE_PASSWORD=medchain

# ------------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND
# ------------------------------------------------------------------------------
PORT=8080
BACKEND_PORT=8080
MEDCHAIN_JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret-string
MEDCHAIN_SEED_DEMO_DATA=false

# CORS Allowed Origins (comma-separated origins for production)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://*.vercel.app,https://*.onrender.com,https://*.netlify.app

# ------------------------------------------------------------------------------
# 3. FASTAPI AI SERVICE & GOOGLE GEMINI FREE-TIER
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
MEDCHAIN_AI_SERVICE_URL=http://localhost:8000
# Obtain free API key with 15 RPM from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# Set to your deployed backend URL in production (e.g., https://medchain-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN (Local Hardhat OR Public Testnet: Polygon Amoy / Sepolia)
# ------------------------------------------------------------------------------
MEDCHAIN_BLOCKCHAIN_ENABLED=true
# Local Hardhat: http://localhost:8545
# Polygon Amoy Testnet: https://rpc-amoy.polygon.technology
MEDCHAIN_BLOCKCHAIN_RPC_URL=http://localhost:8545
MEDCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Chain IDs: 31337 (Local Hardhat), 80002 (Polygon Amoy Testnet), 11155111 (Sepolia)
MEDCHAIN_CHAIN_ID=31337
# Relayer Private Key for signing on-chain transactions (Get free test MATIC from faucet for Amoy)
MEDCHAIN_RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS & ROUTES (Optional - Leaflet/OpenStreetMap is 100% Free Default)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
